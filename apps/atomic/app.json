{
  "expo": {
    "name": "atomic",
    "slug": "atomic",
    "version": "1.0.0",
    "scheme": "atomic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useDayNightTheme": true
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Atomic usa Face ID para abrirse cuando activas el bloqueo."
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Summary",
              "label": "Atomic",
              "description": "Lo que gastaste en el periodo y lo que te queda por día.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.empiricalhq.atomic"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "e99143d8-7b52-4f07-afca-c4dad8cc4b0c"
      }
    }
  }
}
