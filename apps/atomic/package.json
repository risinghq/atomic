{
  "name": "atomic",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Lima jest",
    "build": "expo export --platform web",
    "build-preview": "eas build -p android --profile preview",
    "doctor": "expo-doctor && expo install --check"
  },
  "dependencies": {
    "@atomic/core": "workspace:*",
    "@atomic/ui": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@jest/globals": "^30",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^26.6.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "^30",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
