{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atomic",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "atomic.rising.sh", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atomic",
      "database_id": "b34b8a19-89e0-4de8-a687-c9cfbc388bbf",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
