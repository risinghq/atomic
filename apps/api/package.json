{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars false",
    "typecheck": "bun run types && tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@atomic/core": "workspace:*",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@types/node": "^26.6.7",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
