{
  "compilerOptions": {
    "strict": true,
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "types": []
  },
  "include": ["src", "tests", "vitest.config.mts"]
}
