{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "types": []
  },
  "include": ["src", "tests", "vitest.config.mts"]
}
